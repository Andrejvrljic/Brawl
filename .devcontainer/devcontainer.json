{
  "name": "Kistenkrawall-Server",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Kistenkrawall", "onAutoForward": "openBrowser" }
  },
  "hostRequirements": { "cpus": 2 }
}
